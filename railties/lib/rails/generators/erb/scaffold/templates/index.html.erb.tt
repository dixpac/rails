<p style="color: green"><%%= notice %></p>

<%% content_for :title, "<%= human_name.pluralize %>" %>

<h1><%= human_name.pluralize %></h1>

<p>
  Showing page <%%= @page.number %> of <%%= @page.recordset.page_count %>
  (<%%= @page.recordset.records_count %> total)
</p>

<div id="<%= plural_table_name %>">
  <%% @page.records.each do |<%= singular_table_name %>| %>
    <%%= render <%= singular_table_name %> %>
    <p>
      <%%= link_to "Show this <%= human_name.downcase %>", <%= model_resource_name(singular_table_name) %> %>
    </p>
  <%% end %>
</div>

<%% unless @page.last? %>
  <p><%%= link_to "Next page", <%= index_helper(type: :path) %>(page: @page.next_param) %></p>
<%% end %>

<%%= link_to "New <%= human_name.downcase %>", <%= new_helper(type: :path) %> %>
